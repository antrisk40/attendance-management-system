# Build-time (Vite): required for static hosting (Netlify, Vercel, S3, etc.) where
# there is no /api on the same host. Set the full base URL to your Node API,
# including the /api path.
#
# Example: https://your-backend.railway.app/api
# Netlify: Site settings → Environment variables → add VITE_API_BASE_URL → redeploy
#
# Local dev: leave unset; Vite dev server proxies /api to the backend
# VITE_API_BASE_URL=https://your-api.example.com/api
